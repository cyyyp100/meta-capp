 "tones": [
  {
   "id": "zh.t.1",
   "pinyin": "ā",
   "display": "ā",
   "tone": 1,
   "name": "1er ton",
   "description": "haut et plat, comme une note tenue",
   "example": "妈 mā (maman)",
   "order": 1
  },
  {
   "id": "zh.t.2",
   "pinyin": "á",
   "display": "á",
   "tone": 2,
   "name": "2e ton",
   "description": "montant, comme une question étonnée",
   "example": "麻 má (chanvre)",
   "order": 2
  },
  {
   "id": "zh.t.3",
   "pinyin": "ǎ",
   "display": "ǎ",
   "tone": 3,
   "name": "3e ton",
   "description": "bas ; descend puis remonte en fin de phrase",
   "example": "马 mǎ (cheval)",
   "order": 3
  },
  {
   "id": "zh.t.4",
   "pinyin": "à",
   "display": "à",
   "tone": 4,
   "name": "4e ton",
   "description": "descendant et bref, comme un ordre",
   "example": "骂 mà (gronder)",
   "order": 4
  },
  {
   "id": "zh.t.5",
   "pinyin": "a",
   "display": "a",
   "tone": 5,
   "name": "ton neutre",
   "description": "léger et court, sans marque",
   "example": "吗 ma (particule interrogative)",
   "order": 5
  }
 ],
 "sandhi": [
  {
   "id": "tone3",
   "rule": "Deux 3e tons de suite : le premier se prononce au 2e ton.",
   "example": "你好 nǐ hǎo -> ní hǎo"
  },
  {
   "id": "yi",
   "rule": "一 yī se prononce yí devant un 4e ton, yì devant un 1er, 2e ou 3e ton ; il reste yī seul, en fin de groupe, dans un nombre et après 第.",
   "example": "一个 yí ge ; 一天 yì tiān ; 第一 dì yī"
  },
  {
   "id": "bu",
   "rule": "不 bù se prononce bú devant un 4e ton.",
   "example": "不是 bú shì ; 不好 bù hǎo"
  }
 ],
