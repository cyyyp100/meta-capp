   "text": {
    "title": "Rencontres à la Plaza",
    "summary": "Manolo et Sofía se rencontrent et échangent leurs noms sur la place centrale, tandis que Carmen et Javier observent la scène avec leurs réactions habituelles.",
    "teaser": "Quand Manolo essaiera de 'booster' l'ambiance, que se passera-t-il avec le timing de Javier ?",
    "lines": [
     {
      "speaker": "Manolo",
      "text": "¡Hola! ¿Cómo te llamas?",
      "translation": "Salut ! Comment t'appelles-tu ?"
     },
     {
      "speaker": "Sofía",
      "text": "Hola. Me llamo Sofía.",
      "translation": "Salut. Je m'appelle Sofía."
     },
     {
      "speaker": "Manolo",
      "text": "¡Mucho gusto! ¿Y tú?",
      "translation": "Enchanté ! Et toi ?"
     },
     {
      "speaker": "Sofía",
      "text": "Yo me llamo Sofía.",
      "translation": "Je m'appelle Sofía."
     },
     {
      "speaker": "Carmen",
      "text": "¿Quién eres tú, joven?",
      "translation": "Qui es-tu, jeune homme ?"
     },
     {
      "speaker": "Manolo",
      "text": "Soy Manolo. ¡Qué placer!",
      "translation": "Je suis Manolo. Quel plaisir !"
     },
     {
      "speaker": "Javier",
      "text": "Disculpe. ¿Quién es usted?",
      "translation": "Excusez-moi. Qui êtes-vous ?"
     }
    ]
   },
